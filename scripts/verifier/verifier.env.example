# /etc/implenix-verifier.env  (chmod 600, owned by root)
# Long random string; the same value goes in the dashboard's VERIFIER_SECRET.
# Generate one with: openssl rand -hex 32
VERIFIER_SECRET=
# Host name this server introduces itself as. It needs an A record pointing
# at this server, and the server IP's reverse DNS must point back to it.
VERIFIER_HELO_HOST=verify.implenix.net
# Envelope sender used in the check (no email is ever sent). Use a domain
# you own; it does not need a real mailbox.
VERIFIER_MAIL_FROM=check@verify.implenix.net
# Optional
PORT=8787
VERIFIER_CONCURRENCY=5
