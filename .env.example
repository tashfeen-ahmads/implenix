# Copy to .env.local for local dev. Set the same keys in Vercel for
# production. Everything is optional for `npm run dev`; the site renders
# with safe fallbacks. See LAUNCH_CHECKLIST.md for what each one unlocks.

# Site
NEXT_PUBLIC_SITE_URL=https://implenix.net

# Ron, the in-browser voice agent behind every "Test Ron now" button.
# ElevenLabs Conversational AI agent ID; the agent must allow public
# access (Agent > Security). Unset = Ron panel offers booking instead.
NEXT_PUBLIC_RON_AGENT_ID=

# Booking widget (Google Calendar + Meet). Get the refresh token by
# visiting /api/auth/google/setup once after setting the client ID/secret.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_BOOKING_HOST_EMAIL=
GOOGLE_BOOKING_TIMEZONE=America/New_York
GOOGLE_BOOKING_DURATION_MINUTES=30
GOOGLE_BOOKING_WORKING_DAYS=1,2,3,4,5
GOOGLE_BOOKING_WORKING_HOURS_START=9
GOOGLE_BOOKING_WORKING_HOURS_END=18
GOOGLE_BOOKING_MIN_LEAD_HOURS=4
GOOGLE_BOOKING_MAX_LEAD_DAYS=30

# Zoom (optional). With all three set, every booking gets a Zoom meeting
# and the Google Calendar invite emailed to the visitor carries the Zoom
# link. Create a Server-to-Server OAuth app at marketplace.zoom.us with
# scopes meeting:write:meeting:admin + meeting:delete:meeting:admin.
# Unset = Google Meet.
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
# Licensed Zoom user who hosts the meetings. Blank = the app owner.
ZOOM_HOST_EMAIL=

# CRM webhook: leads (/api/leads, audit tool) and calendar bookings are
# POSTed here as JSON. See docs/CRM_WEBHOOK.md for the payload and how
# to verify the signature.
CRM_WEBHOOK_URL=
# HMAC-SHA256 signing secret (recommended). Any long random string.
CRM_WEBHOOK_SECRET=
# Optional bearer token, for receivers that prefer header auth.
CRM_WEBHOOK_TOKEN=

# GoHighLevel form IDs (only if using GHL embeds)
NEXT_PUBLIC_GHL_FORM_DEMO=
NEXT_PUBLIC_GHL_FORM_CONTACT=
NEXT_PUBLIC_GHL_FORM_LP=
NEXT_PUBLIC_GHL_FORM_INDUSTRY=
NEXT_PUBLIC_GHL_FORM_CASESTUDY=
NEXT_PUBLIC_GHL_FORM_NEWSLETTER=
NEXT_PUBLIC_GHL_FORM_ROI_GATE=

# Analytics / ads
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION_LABEL=

# Search engine verification + IndexNow
NEXT_PUBLIC_GOOGLE_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
INDEXNOW_KEY=
NEXT_PUBLIC_INDEXNOW_KEY=
INDEXNOW_PING=0

# ── Outreach (Amazon SES + OpenAI) ─────────────────────────────────
# Cold outreach sends through Amazon SES on a SEPARATE sending domain or
# subdomain (never Resend, never the main implenix.net mail). Setup guide:
# docs/OUTREACH.md.
# SES region and an IAM user limited to ses:SendRawEmail / ses:SendEmail.
AWS_SES_REGION=us-east-1
AWS_SES_ACCESS_KEY_ID=
AWS_SES_SECRET_ACCESS_KEY=
# Configuration set with the SNS event destination (bounce/complaint/delivery).
SES_CONFIGURATION_SET=
# Verified SES sending domain; campaign From addresses must be on it.
# Also used for generated Message-IDs. e.g. outreach.implenix.net
OUTREACH_FROM_DOMAIN=
# Physical postal address shown in every outreach email (CAN-SPAM).
OUTREACH_POSTAL_ADDRESS=
# Max outreach emails per day across all campaigns (warm-up cap).
OUTREACH_GLOBAL_DAILY_LIMIT=200
# Timezone that defines "today" for the global cap.
OUTREACH_TIMEZONE=America/New_York
# Long random string; signs unsubscribe links (openssl rand -hex 32).
# Changing it invalidates links in emails already sent.
OUTREACH_UNSUBSCRIBE_SECRET=
# Optional mailto for List-Unsubscribe (must be received by the SES
# inbound receipt rule), e.g. unsubscribe@reply.outreach.implenix.net
OUTREACH_UNSUBSCRIBE_MAILTO=
# Optional comma-separated allow-list of SNS topic ARNs that may post to
# /api/outreach/ses (inbound topic and events topic). Blank = any topic
# with a valid AWS signature.
SES_INBOUND_SNS_TOPIC_ARN=
# Vercel Cron sends "Authorization: Bearer $CRON_SECRET" to
# /api/cron/outreach every 10 minutes (see vercel.json).
CRON_SECRET=
# AI reply agent (Responses API). Confirm the model ID you have access to.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# ── Team dashboard + onboarding (docs/TEAM_DASHBOARD.md) ──────────────
# Supabase project: database for clients, bookings, outreach + team login.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS; used by the booking API, SES webhooks, cron.
SUPABASE_SERVICE_ROLE_KEY=

# Resend: booking confirmations and updates from update@implenix.net.
# Transactional only; cold outreach goes through Amazon SES (below).
RESEND_API_KEY=
RESEND_FROM="Implenix <update@implenix.net>"
RESEND_REPLY_TO=support@implenix.net
# Comma-separated team inboxes that get a "new booking" alert.
BOOKING_TEAM_EMAILS=
